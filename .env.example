# Local defaults. Copy to .env or use the gitignored .env already in the repo.
# Compose reads .env for substitution and injects it into the containers.
# Inside Compose, DATABASE_URL and REDIS_URL point at the service names.
PORT=8000
LLM_BASE_URL=
LLM_API_KEY=
# Optional pool file (default path). Copy from config/llm_credentials.example.yaml.
LLM_CREDENTIALS_FILE=config/llm_credentials.yaml
# Local harvested keys (gitignored): set -a && source .env.llm && set +a
# Inline JSON overrides the file when set.
# LLM_CREDENTIALS=
PLATFORM_ADMIN_TOKEN=local-admin
PLATFORM_KEY_PEPPER=local-pepper
POSTGRES_PASSWORD=genai
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://genai:genai@localhost:5432/genai
REDIS_URL=redis://localhost:6379/0
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
# Tool execution plane. Empty TOOLS_URL keeps write tools in-process (unit tests).
TOOLS_URL=
TOOLS_TOKEN=local-tools-token
TOOLS_PORT=8081
